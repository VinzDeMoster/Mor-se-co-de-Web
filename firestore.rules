rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if admin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow write: if false;
    }

    match /history/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      allow update: if false;
    }

    match /announcements/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }
  }
}